[Unit]
Description=W09 generic Research Inbox planning worker for %i
Wants=network-online.target
After=network-online.target chrony.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0027
WorkingDirectory=/srv/w09-research
ExecCondition=/usr/bin/sha256sum -c /etc/w09/research_inbox.sha256
ExecCondition=+/usr/local/libexec/w09-research-inbox-control verify-start --protocol research-w09-dispatch-interface-v1 --job-id %i
ExecStart=/usr/local/bin/w09-run /opt/w09/venv/bin/python /opt/w09/research/deploy/w09/research_job_worker.py --job-id %i --inbox-root /srv/w09-research/inbox --cache-root /srv/w09-research/cache
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
CPUWeight=25
IOWeight=25
MemoryHigh=8G
MemoryMax=12G
TasksMax=128
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/w09-research/inbox
ReadOnlyPaths=/srv/w09-research/cache
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

# This template is never enabled or timer-driven.  A direct systemctl start
# fails ExecCondition unless the root-owned, short-lived explicit-start arm
# was created by the fixed control helper.
