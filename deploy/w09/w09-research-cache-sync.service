[Unit]
Description=W09 read-only exact-version V3 research cache sync
Wants=network-online.target
After=network-online.target chrony.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
WorkingDirectory=/srv/w09-research
Environment=PYTHONDONTWRITEBYTECODE=1
ExecCondition=/usr/bin/sha256sum -c /etc/w09/research_cache_sync.sha256
ExecStart=/opt/w09/venv/bin/python /opt/w09/research/tools/research_cache_sync.py --root s3://kalshi-vault-ritcardo/research --cache-root /srv/w09-research/cache --lookback-days 35
TimeoutStartSec=12h
Nice=10
IOSchedulingClass=idle
CPUWeight=25
IOWeight=25
MemoryHigh=8G
MemoryMax=12G
TasksMax=128
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/w09-research/cache
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# There is no Restart=.  The persistent hourly timer is the retry mechanism;
# STATE.json retains every historical pending date across invocations.
