[Unit]
Description=W09 MODE 1 exact-version exploratory autoresearch
Wants=network-online.target
After=network-online.target chrony.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
WorkingDirectory=/srv/w09-research
ExecStartPre=/usr/bin/sha256sum -c /etc/w09/exploratory_autoresearch.sha256
ExecStart=/usr/local/bin/w09-run /opt/w09/venv/bin/python /opt/w09/research/tools/exploratory_autoresearch.py --start-date 2026-07-10
TimeoutStartSec=24h
Nice=10
IOSchedulingClass=idle
CPUWeight=50
IOWeight=25
MemoryHigh=40G
MemoryMax=52G
TasksMax=512
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/w09-research
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# No Restart=.  The persistent timer is the bounded retry path, and the
# application-level receipt prevents duplicate research for one selection.
