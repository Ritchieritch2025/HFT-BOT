[Unit]
Description=W09 MODE 1 exact-version exploratory autoresearch
Wants=network-online.target
After=network-online.target chrony.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
WorkingDirectory=/srv/w09-research
ExecCondition=/usr/bin/sha256sum -c /etc/w09/exploratory_autoresearch.sha256
ExecCondition=/opt/w09/venv/bin/python /opt/w09/research/tools/deep03_authority_gate.py --authority /etc/w09/deep03/AUTHORITY.json --arm-file /etc/w09/deep03/approvals/d3-w2a-execution-arm.json --plan /etc/w09/deep03/adopted-plan.md --runtime-commit /opt/w09/research/release-commit.txt
ExecStart=/usr/local/bin/w09-run /opt/w09/venv/bin/python /opt/w09/research/tools/exploratory_autoresearch.py --authority /etc/w09/deep03/AUTHORITY.json --arm-file /etc/w09/deep03/approvals/d3-w2a-execution-arm.json --plan /etc/w09/deep03/adopted-plan.md --runtime-commit /opt/w09/research/release-commit.txt
TimeoutStartSec=24h
Nice=10
IOSchedulingClass=idle
CPUWeight=50
IOWeight=25
MemoryHigh=40G
MemoryMax=52G
TasksMax=512
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/w09-research
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# No Restart=.  The persistent timer is the bounded retry path, and the
# application-level receipt prevents duplicate research for one selection.
