[Unit]
Description=W09 MODE 1 exact-version exploratory autoresearch
Wants=network-online.target
After=network-online.target chrony.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
WorkingDirectory=/srv/w09-research
ExecCondition=/usr/bin/sha256sum -c /etc/w09/exploratory_autoresearch.sha256
ExecCondition=/opt/w09/venv/bin/python /opt/w09/research/tools/deep03_authority_gate.py --authority /etc/w09/deep03/AUTHORITY.json --arm-file /etc/w09/deep03/approvals/d3-w2a-execution-arm.json --plan /etc/w09/deep03/adopted-plan.md --runtime-commit /opt/w09/research/release-commit.txt --audit /etc/w09/deep03/audit.md --w0-release /etc/w09/deep03/releases/D3-W0-20260719-13.json --w1-release /etc/w09/deep03/releases/D3-W1-20260719-13.json --w1-complete /etc/w09/deep03/prerequisites/W1_COMPLETE.json --l2-independent-audit-receipt /etc/w09/deep03/l2/L2_INDEPENDENT_AUDIT_RECEIPT.json --l2-independent-audit-report /etc/w09/deep03/l2/L2_INDEPENDENT_AUDIT_REPORT.md
ExecStartPre=+/opt/w09/venv/bin/python /opt/w09/research/tools/deep03_one_shot_arm.py claim --authority /etc/w09/deep03/AUTHORITY.json --arm-file /etc/w09/deep03/approvals/d3-w2a-execution-arm.json --claim-root /var/lib/w09-deep03/one-shot --service-unit w09-exploratory-autoresearch.service
ExecStart=/usr/local/bin/w09-run /opt/w09/venv/bin/python /opt/w09/research/tools/exploratory_autoresearch.py --authority /etc/w09/deep03/AUTHORITY.json --arm-file /etc/w09/deep03/approvals/d3-w2a-execution-arm.json --arm-claim-root /var/lib/w09-deep03/one-shot --plan /etc/w09/deep03/adopted-plan.md --runtime-commit /opt/w09/research/release-commit.txt --audit /etc/w09/deep03/audit.md --w0-release /etc/w09/deep03/releases/D3-W0-20260719-13.json --w1-release /etc/w09/deep03/releases/D3-W1-20260719-13.json --w1-complete /etc/w09/deep03/prerequisites/W1_COMPLETE.json --l2-independent-audit-receipt /etc/w09/deep03/l2/L2_INDEPENDENT_AUDIT_RECEIPT.json --l2-independent-audit-report /etc/w09/deep03/l2/L2_INDEPENDENT_AUDIT_REPORT.md --checkpoint-root /srv/w09-research/checkpoints --checkpoint-reserve-bytes 8589934592
ExecStopPost=+/opt/w09/venv/bin/python /opt/w09/research/tools/deep03_one_shot_arm.py consume --authority /etc/w09/deep03/AUTHORITY.json --arm-file /etc/w09/deep03/approvals/d3-w2a-execution-arm.json --claim-root /var/lib/w09-deep03/one-shot --service-unit w09-exploratory-autoresearch.service
TimeoutStartSec=24h
Nice=10
IOSchedulingClass=idle
CPUWeight=50
IOWeight=25
MemoryHigh=40G
MemoryMax=52G
TasksMax=512
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/w09-research /var/lib/w09-deep03/one-shot
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# No Restart=.  This exact ARM is claimed once and consumed by ExecStopPost;
# neither a timer retry nor a direct prepare/runner can reuse it.
