# /etc/kalshi/tradingd.env — environment for tradingd.service
# chmod 640 root:ubuntu (must not be world-readable: it names the key path)

KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PRIVATE_KEY_PATH=/etc/kalshi/private_key.pem
KALSHI_BASE_URL=https://external-api.kalshi.com

# Cold-path telemetry (drops harmlessly if Redis is down)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Engine knobs
TRADINGD_WORKERS=2              # dedicated warm HTTP/2 connections
TRADINGD_RING=1024
TRADINGD_SPIN=0                 # 1 = busy-poll workers (needs dedicated cores)
TRADINGD_MAX_QUEUE_AGE_MS=2000
TRADINGD_MAX_ORDERS_PER_SEC=0   # SET THIS to your Kalshi rate-limit tier
TRADINGD_KEEPALIVE_S=15
TRADINGD_DRAIN_MS=2000
