[Unit]
Description=Kalshi fail-safe zero-copy canonical durable receipt builder
Wants=network-online.target
After=network-online.target
# Deliberately independent of capture and seal services.  Failure here must
# never restart, stop, or delay market-data collection.

[Service]
Type=oneshot
User=kalshi-research-v3
Group=kalshi-research-v3
SupplementaryGroups=kalshi-publication
WorkingDirectory=/opt/kalshi-research-v3
UMask=0007
Environment=PATH=/opt/kalshi-research-v3/.venv/bin:/snap/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/kalshi-research-v3
Environment=GIT_CONFIG_SYSTEM=/etc/kalshi-research-v3/gitconfig
Environment=GIT_CONFIG_GLOBAL=/dev/null
Environment=GIT_OPTIONAL_LOCKS=0
Environment=GIT_TERMINAL_PROMPT=0
StateDirectory=kalshi-research-v3
StateDirectoryMode=0700
LoadCredentialEncrypted=publisher.env:/etc/credstore.encrypted/kalshi-research-v3-publisher.env
ExecCondition=/usr/bin/test -f /etc/kalshi-research-v3/approvals/cutover-approved
ExecCondition=/usr/bin/test -f /etc/kalshi-research-v3/approvals/publish-approved
ExecCondition=+/usr/bin/test ! -e /home/ubuntu/.kalshi/research_s3.env.sh
ExecStartPre=/usr/bin/test -d /home/ubuntu/hft-bot/work/live/research_v3_daily
ExecStartPre=/usr/bin/test -d /home/ubuntu/hft-bot/work/live/fresh_rfq_research
ExecStartPre=/usr/bin/test -d /home/ubuntu/hft-bot/work/warehouse/.publication-locks
ExecStartPre=/usr/bin/test -r /etc/kalshi-research-v3/gitconfig
ExecStart=/opt/kalshi-research-v3/.venv/bin/python /opt/kalshi-research-v3/tools/research_v3_daily.py --scan-ready-days 35 --durable-only --live-dir /home/ubuntu/hft-bot/work/live --receipt-root /opt/kalshi-research-v3-historical-canonical-receipts --audit-root /home/ubuntu/hft-bot/work/live/research_v3_audit --raw-root /home/ubuntu/hft-bot/work/raw --warehouse-root /home/ubuntu/hft-bot/work/warehouse --quality-dir /home/ubuntu/hft-bot/work/event_packs --fresh-rfq-eligibility-root /home/ubuntu/hft-bot/work/live/fresh_rfq_research --publisher-env-file %d/publisher.env --cutover-arm-file /etc/kalshi-research-v3/approvals/cutover-approved --publish-arm-file /etc/kalshi-research-v3/approvals/publish-approved --home /var/lib/kalshi-research-v3 --publisher-principal arn:aws:iam::321572485933:user/vaultWriter --aws-cli /snap/aws-cli/current/bin/aws --python /opt/kalshi-research-v3/.venv/bin/python --operator-approved
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=24h
CPUWeight=20
CPUQuota=150%
IOWeight=10
MemoryHigh=4G
MemoryMax=6G
TasksMax=256
OOMScoreAdjust=500

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/kalshi-research-v3 /opt/kalshi-research-v3-historical-canonical-receipts /home/ubuntu/hft-bot/work/raw /home/ubuntu/hft-bot/work/warehouse /home/ubuntu/hft-bot/work/event_packs /home/ubuntu/hft-bot/work/live/fresh_rfq_research /home/ubuntu/.kalshi /etc/kalshi-research-v3/approvals /etc/kalshi-research-v3/gitconfig
ReadWritePaths=/home/ubuntu/hft-bot/work/warehouse/.publication-locks /home/ubuntu/hft-bot/work/live/canonical_receipts/controls /home/ubuntu/hft-bot/work/live/canonical_receipts/durable /home/ubuntu/hft-bot/work/live/canonical_receipts/forward-aux /home/ubuntu/hft-bot/work/live/canonical_receipts/forward-metadata-preflight /home/ubuntu/hft-bot/work/live/canonical_receipts/forward-version-bindings /home/ubuntu/hft-bot/work/live/research_v3_daily /home/ubuntu/hft-bot/work/research_stage
