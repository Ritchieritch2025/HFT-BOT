[Unit]
Description=Kalshi publisher-only exact canonical generation witness
Wants=network-online.target
After=network-online.target
OnSuccess=kalshi-research-v3-durable.service
# No capture/seal unit dependency: this retrying observer can fail without
# stopping, restarting, or delaying market-data collection.

[Service]
Type=oneshot
User=kalshi-research-v3
Group=kalshi-research-v3
SupplementaryGroups=kalshi-publication
WorkingDirectory=/opt/kalshi-research-v3
UMask=0077
Environment=PATH=/opt/kalshi-research-v3/.venv/bin:/snap/aws-cli/current/bin:/usr/bin:/bin
Environment=HOME=/var/lib/kalshi-research-v3
StateDirectory=kalshi-research-v3
StateDirectoryMode=0700
LoadCredentialEncrypted=publisher.env:/etc/credstore.encrypted/kalshi-research-v3-publisher.env
ExecCondition=/usr/bin/test -f /etc/kalshi-research-v3/approvals/cutover-approved
ExecCondition=+/usr/bin/test ! -e /home/ubuntu/.kalshi/research_s3.env.sh
ExecStartPre=/usr/bin/test -d /home/ubuntu/hft-bot/work/warehouse/.publication-generations/dim
ExecStartPre=/usr/bin/test -d /home/ubuntu/hft-bot/work/warehouse/.publication-locks
ExecStartPre=/usr/bin/test -d /home/ubuntu/hft-bot/work/live/canonical_receipts/generation-daily
ExecStartPre=/usr/bin/test -d /home/ubuntu/hft-bot/work/live/canonical_receipts/generation-witness-intents
ExecStartPre=/usr/bin/test -f /var/lib/kalshi-research-v3-locks/generation-witness.lock
ExecStart=/opt/kalshi-research-v3/.venv/bin/python /opt/kalshi-research-v3/tools/canonical_generation_daily.py --publisher-env-file %d/publisher.env --operator-approved
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=24h
CPUWeight=20
CPUQuota=150%
IOWeight=10
MemoryHigh=4G
MemoryMax=6G
TasksMax=256
OOMScoreAdjust=500

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/kalshi-research-v3 /home/ubuntu/hft-bot/work/raw /home/ubuntu/hft-bot/work/warehouse /home/ubuntu/.kalshi /etc/kalshi-research-v3/approvals
ReadWritePaths=/home/ubuntu/hft-bot/work/warehouse/.publication-locks /home/ubuntu/hft-bot/work/live/canonical_receipts/generation-daily /home/ubuntu/hft-bot/work/live/canonical_receipts/generation-witness-intents /var/lib/kalshi-research-v3-locks/generation-witness.lock
