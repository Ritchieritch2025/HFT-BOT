[Unit]
Description=Crypto 15m paired market-making shadow experiment
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/ubuntu
EnvironmentFile=/home/ubuntu/mm_experiments/shadow_prequote_20260726/shadow.env
ExecStartPre=/usr/bin/test -f /home/ubuntu/mm_experiments/shadow_prequote_20260726/release/mm_engine.py
ExecStart=/usr/bin/env MM_MODE=shadow /home/ubuntu/venvs/crypto-ws/bin/python /home/ubuntu/mm_experiments/shadow_prequote_20260726/release/mm_engine.py
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=append:/home/ubuntu/mm_experiments/shadow_prequote_20260726/runner.log
StandardError=append:/home/ubuntu/mm_experiments/shadow_prequote_20260726/runner.log
UMask=0077

[Install]
WantedBy=default.target
