{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "W05ResearchListPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::kalshi-vault-ritcardo",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "research/",
            "research/*"
          ]
        }
      }
    },
    {
      "Sid": "W05ResearchGetObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::kalshi-vault-ritcardo/research/*"
    }
  ]
}
