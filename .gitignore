build/
*.dSYM/
work/
.DS_Store
# test-generated data artifacts (raw logs, replays, rotation shards, fuzz corpus)
*.ndjson
*.ndjson.*
# warehouse data + raw capture layers (never commit market data or DB files)
raw/
warehouse/
*.duckdb
*.duckdb.wal
*.parquet
*.csv.gz
# credentials must never live in the repo (real creds belong in ~/.kalshi/env.sh)
*.pem
*key*.json
.env
.env.*
.attic/
# test fixtures are ALWAYS tracked — the global data-format ignores above must
# never swallow them (audit G2 / R decision 4, 2026-07-06); a suite assertion
# (test_all_fixture_files_are_git_tracked) enforces this
!tests/fixtures/**
