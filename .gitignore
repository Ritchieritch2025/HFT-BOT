build/
*.dSYM/
# work/ is the data tree (never committed) EXCEPT work/research/ committed
# research TOOLS (W-TL1: jitter_report.py). Git cannot re-include files under
# an ignored directory, so work must be ignored as work/* with an explicit
# re-include chain; report OUTPUTS in work/research/ stay ignored.
work/*
!work/research/
work/research/*
!work/research/jitter_report.py
.DS_Store
# test-generated data artifacts (raw logs, replays, rotation shards, fuzz corpus)
*.ndjson
*.ndjson.*
# warehouse data + raw capture layers (never commit market data or DB files)
raw/
warehouse/
*.duckdb
*.duckdb.wal
*.parquet
*.csv.gz
# credentials must never live in the repo (real creds belong in ~/.kalshi/env.sh)
*.pem
*key*.json
.env
.env.*
.attic/
# test fixtures are ALWAYS tracked — the global data-format ignores above must
# never swallow them (audit G2 / R decision 4, 2026-07-06); a suite assertion
# (test_all_fixture_files_are_git_tracked) enforces this
!tests/fixtures/**

# pipeline-churned classification outputs (rider (c), W-A5): regenerated hourly
# by build_classification on the production box; git history was pure noise
config/classification_review.csv
config/series_tags_report.csv

# local Research Workbench API snapshots (rebuilt from manifest + artifacts)
sandbox/research/reports/workbench/
